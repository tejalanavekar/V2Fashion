---
const year = new Date().getFullYear();
---

<footer class="flex flex-col gap-12 bg-footer-bg px-16 pt-18 pb-8 text-footer-ink box-border">
  <div class="grid grid-cols-[1.6fr_1fr_1fr_1fr_1.2fr] gap-10">
    <div class="flex flex-col gap-3.5">
      <span class="font-display text-3xl font-bold tracking-[0.08em]">V2FASHION</span>
      <p class="m-0 text-[15px] leading-relaxed text-footer-muted">
        Indian ethnic wear and jewellery for the whole family, handpicked by us.
      </p>
      <span class="text-[13px] text-footer-muted">Pay online with UPI, cards or netbanking</span>
    </div>

    <div class="flex flex-col gap-3 text-[15px]">
      <span class="font-semibold text-accent-on-dark">Shop</span>
      <a href="/women" class="text-footer-muted no-underline">Women</a>
      <a href="/men" class="text-footer-muted no-underline">Men</a>
      <a href="/kids" class="text-footer-muted no-underline">Kids</a>
      <a href="/jewellery" class="text-footer-muted no-underline">Jewellery</a>
    </div>

    <div class="flex flex-col gap-3 text-[15px]">
      <span class="font-semibold text-accent-on-dark">Help</span>
      <a href="/account/orders" class="text-footer-muted no-underline">Track my order</a>
      <a href="/policies/shipping" class="text-footer-muted no-underline">Shipping</a>
      <a href="/policies/exchanges" class="text-footer-muted no-underline">Exchanges</a>
      <a href="/size-guide" class="text-footer-muted no-underline">Size guide</a>
      <a href="/contact" class="text-footer-muted no-underline">Contact us</a>
    </div>

    <div class="flex flex-col gap-3 text-[15px]">
      <span class="font-semibold text-accent-on-dark">Policies</span>
      <a href="/policies/privacy" class="text-footer-muted no-underline">Privacy</a>
      <a href="/policies/terms" class="text-footer-muted no-underline">Terms</a>
      <a href="/policies/grievance" class="text-footer-muted no-underline">Grievance officer</a>
    </div>

    <div class="flex flex-col gap-3.5 text-[15px]">
      <span class="font-semibold text-accent-on-dark">Follow us</span>
      <div class="flex gap-2.5">
        <a
          href="#"
          aria-label="Instagram"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-footer-muted text-footer-ink"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="4" y="4" width="16" height="16" rx="4"></rect>
            <circle cx="12" cy="12" r="3.6"></circle>
            <circle cx="17" cy="7" r="0.8" fill="currentColor"></circle>
          </svg>
        </a>
        <a
          href="#"
          aria-label="Facebook"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-footer-muted text-footer-ink"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="flex justify-between border-t border-white/15 pt-6 text-[13px] text-footer-muted">
    <span>© {year} V2Fashion. All rights reserved.</span>
    <span>Made with care in India</span>
  </div>
</footer>
