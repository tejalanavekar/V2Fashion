---
export type Category = "women" | "men" | "kids" | "jewellery";

interface Props {
  active?: Category;
  cartCount?: number;
}

const { active, cartCount = 0 } = Astro.props;

const navLinks: { label: string; href: string; category: Category }[] = [
  { label: "Women", href: "#", category: "women" },
  { label: "Men", href: "#", category: "men" },
  { label: "Kids", href: "#", category: "kids" },
  { label: "Jewellery", href: "#", category: "jewellery" },
];
---

<header
  class="flex h-[84px] shrink-0 items-center justify-between border-b border-line bg-surface px-16 box-border"
>
  <a
    href="/"
    class="font-display text-3xl font-bold tracking-[0.08em] text-primary no-underline"
  >
    V2FASHION
  </a>

  <nav aria-label="Main" class="flex gap-10 text-base font-medium">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={active === link.category ? "page" : undefined}
          class:list={[
            "border-b-2 border-transparent pb-1 text-ink no-underline transition-colors",
            link.category === "men"
              ? "hover:text-men-accent hover:border-men-accent aria-[current]:text-men-accent aria-[current]:border-men-accent"
              : "hover:text-primary hover:border-accent aria-[current]:text-primary aria-[current]:border-accent",
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a href="#" class="border-b-2 border-transparent pb-1 text-primary no-underline">
      Festive edit
    </a>
  </nav>

  <div class="flex items-center gap-1">
    <button
      type="button"
      aria-label="Search"
      class="flex h-11 w-11 items-center justify-center rounded-full border-0 bg-transparent text-ink"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.5-3.5"></path>
      </svg>
    </button>
    <a
      href="#"
      aria-label="Wishlist"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-transparent text-ink"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path>
      </svg>
    </a>
    <a
      href="#"
      aria-label="Account"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-transparent text-ink"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <circle cx="12" cy="8" r="4"></circle>
        <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path>
      </svg>
    </a>
    <a
      href="#"
      aria-label={`Cart, ${cartCount} items`}
      class="relative flex h-11 w-11 items-center justify-center rounded-full bg-transparent text-ink"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M5 8h14l-1.2 12H6.2z"></path>
        <path d="M9 8a3 3 0 0 1 6 0"></path>
      </svg>
      {
        cartCount > 0 && (
          <span class="absolute top-1 right-0.5 flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-primary text-[11px] font-semibold text-white">
            {cartCount}
          </span>
        )
      }
    </a>
  </div>
</header>
